# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL — either DATABASE_URL or the PG* values below
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmacy_mvp
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=pharmacy_mvp
DB_POOL_MAX=10

# Auth
JWT_SECRET=change-me-in-dev-only
JWT_EXPIRES_IN=1d
BCRYPT_COST=10

# Password for every demo user created by `npm run seed`
SEED_PASSWORD=Dosely@123

# Notifications (Commit 6)
SMS_PROVIDER=stub            # stub logs messages instead of sending them
EMAIL_PROVIDER=stub
NOTIFY_WORKER=on             # off = don't run the delivery job inside the API (run `npm run jobs:notifications`)
NOTIFY_WORKER_INTERVAL_MS=5000
NOTIFY_BACKOFF_BASE_MS=30000 # retry after 30s, 1m, 2m, 4m (max 5 attempts)
NOTIFY_STUB_FAIL=            # e.g. +919810000105,bad@example.com — the stub fails these, to try retries
